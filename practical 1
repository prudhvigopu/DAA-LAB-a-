const int SIZE = 100; 
 
void bubble(int a[]) 
{ 
    for(int pass=0; pass<SIZE-1; pass++) 
    { 
        for(int i=0; i<SIZE-pass-1; i++) 
        { 
            if(a[i]>a[i+1]) 
            {                 int t=a[i];                 a[i]=a[i+1];                 a[i+1]=t; 
            } 
        } 
    } 
} 
 
void selection(int a[]) 
{ 
    for(int i=0;i<SIZE-1;i++) 
    { 
        int pos=i; 
 
        for(int j=i+1;j<SIZE;j++) 
        { 
            if(a[j]<a[pos])                 pos=j; 
        } 
 
        int t=a[pos];         a[pos]=a[i];         a[i]=t; 
    } 
} 
 
void insertion(int a[]) {     for(int i=1;i<SIZE;i++) 
    {         int value=a[i];         int j=i-1; 
 
        while(j>=0 && a[j]>value) 
        {             a[j+1]=a[j];             j--; 
        } 
 
        a[j+1]=value; 
    } 
} 
 
